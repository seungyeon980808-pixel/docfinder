# Local preview: npm run start:shared, then open http://localhost:4175 in Safari.
DOCFINDER_ORIGIN=http://localhost:4175
PORT=4175
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development uses persistent embedded PostgreSQL when this is empty.
DATABASE_URL=
# Production: 64 hexadecimal characters, generated once and stored securely.
DOCFINDER_ENCRYPTION_KEY=
# Private server data, never served or included in a release.
DOCFINDER_DATA_DIR=.docfinder-data
# File size cap: integer 1..128 MB. Render Free uses 32.
DOCFINDER_MAX_FILE_MB=128
# Extraction worker JavaScript heap: integer 64..512 MB. Render Free uses 192.
# This is not a cap on native/WASM allocations or total process memory.
DOCFINDER_INDEX_MEMORY_MB=512
